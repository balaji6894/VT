openapi: 3.0.1
info:
  title: VirusTotal Test API
  version: "1.0"

servers:
  - url: https://www.virustotal.com/api/v3

paths:
  /urls:
    post:
      operationId: scanUrl
      summary: Submit URL for scanning
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              type: object
              properties:
                url:
                  type: string
      responses:
        '200':
          description: OK
